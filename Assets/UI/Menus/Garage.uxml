<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Common.uss" />
    <Style src="Menus.uss" />
    <ui:VisualElement name="garage" class="screen" picking-mode="Ignore">
        <ui:VisualElement name="viewport" class="viewport" />
        <ui:VisualElement class="top-bar" picking-mode="Ignore">
            <ui:VisualElement class="title-accent" picking-mode="Ignore" />
            <ui:Label name="screen-title" text="GARAGE" class="screen-title" picking-mode="Ignore" />
            <ui:VisualElement class="tabs" picking-mode="Ignore">
                <ui:Label name="tab-cars" text="CARS" class="tab tab--active" picking-mode="Ignore" />
                <ui:Label name="tab-upgrades" text="UPGRADES" class="tab" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="top-bar-spacer" picking-mode="Ignore" />
            <ui:VisualElement class="credits-pill" picking-mode="Ignore">
                <ui:Label text="CREDITS" class="credits-caption" picking-mode="Ignore" />
                <ui:Label name="credits" text="0 CR" class="credits-value" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="car-counter" text="1 / 1" class="screen-counter" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="info-panel" class="panel garage-info" picking-mode="Ignore">
            <ui:Label name="car-category" class="car-category" picking-mode="Ignore" />
            <ui:Label name="car-name" class="car-name" picking-mode="Ignore" />
            <ui:VisualElement class="name-stripe" picking-mode="Ignore" />
            <ui:Label name="car-specs" class="car-specs" picking-mode="Ignore" />
            <ui:Label name="car-description" class="car-description" picking-mode="Ignore" />
            <ui:Label name="car-status" class="status" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="upgrade-panel" class="panel garage-info upgrade-panel">
            <ui:Label text="UPGRADES" class="car-category" picking-mode="Ignore" />
            <ui:Label name="upgrade-car" class="upgrade-car" picking-mode="Ignore" />
            <ui:VisualElement name="upgrade-list" class="upgrade-list" />
            <ui:Label name="upgrade-description" class="car-description upgrade-description" picking-mode="Ignore" />
            <ui:Label name="upgrade-status" class="status" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="panel garage-stats" picking-mode="Ignore">
            <ui:Label text="PERFORMANCE" class="caption stats-caption" picking-mode="Ignore" />
            <ui:VisualElement name="stat-list" picking-mode="Ignore" />
            <ui:Label name="stats-legend" text="White tick: the car you race now" class="stats-legend" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="garage-bottom" picking-mode="Ignore">
            <ui:Button name="back-button" text="BACK" class="action action--secondary" />
            <ui:VisualElement class="car-switcher" picking-mode="Ignore">
                <ui:Button name="previous-button" text="&lt;" class="arrow-button" />
                <ui:VisualElement name="car-dots" class="car-dots" picking-mode="Ignore" />
                <ui:Button name="next-button" text="&gt;" class="arrow-button" />
            </ui:VisualElement>
            <ui:VisualElement class="action-group" picking-mode="Ignore">
                <ui:Button name="upgrades-button" text="UPGRADES" class="action action--secondary" />
                <ui:Button name="select-button" text="SELECT" class="action action--primary" />
                <ui:Button name="buy-button" text="BUY" class="action action--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="hint-bar" picking-mode="Ignore">
            <ui:VisualElement name="hint-keys" class="hint-keys" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="confirm" class="confirm">
            <ui:VisualElement class="confirm-card">
                <ui:Label text="CONFIRM UPGRADE" class="caption" />
                <ui:Label name="confirm-title" class="confirm-title" />
                <ui:Label name="confirm-details" class="confirm-details" />
                <ui:VisualElement class="confirm-buttons">
                    <ui:Button name="confirm-cancel" text="CANCEL" class="action action--secondary" />
                    <ui:Button name="confirm-buy" text="CONFIRM" class="action action--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
