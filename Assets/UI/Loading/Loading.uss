/* Loading screen (LoadingScreen). Covers every scene's UI while a scene is swapped. */

.loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(7, 9, 13);
    overflow: hidden;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-sine;
}

/* Hidden state: faded out, stripes off to the side. The fade in and out come from removing and adding it. */
.loading--hidden {
    opacity: 0;
}

.loading-stripe {
    position: absolute;
    top: -300px;
    bottom: -300px;
    rotate: 14deg;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-cubic;
}

.loading-stripe--wide {
    right: 120px;
    width: 260px;
    background-color: var(--rally-yellow);
}

.loading-stripe--thin {
    right: 420px;
    width: 26px;
    background-color: rgba(255, 255, 255, 0.85);
}

.loading--hidden .loading-stripe {
    translate: 420px 0;
}

.loading-logo {
    position: absolute;
    left: 110px;
    top: 80px;
    flex-direction: row;
    align-items: flex-end;
}

.loading-logo-rally {
    margin: 0;
    padding: 0;
    font-size: 44px;
    letter-spacing: 3px;
    color: var(--rally-white);
    -unity-font-style: bold-and-italic;
}

.loading-logo-x {
    margin: 0 0 0 8px;
    padding: 0;
    font-size: 52px;
    color: var(--rally-yellow);
    -unity-font-style: bold-and-italic;
}

.loading-map {
    position: absolute;
    right: 520px;
    top: 100px;
    width: 460px;
    height: 460px;
}

.loading-map-drawing {
    flex-grow: 1;
}

.loading-content {
    position: absolute;
    left: 110px;
    bottom: 250px;
    max-width: 1100px;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-cubic;
}

.loading--hidden .loading-content {
    translate: -60px 0;
}

.loading-title {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 128px;
    letter-spacing: 4px;
    color: var(--rally-white);
    -unity-font-style: bold-and-italic;
}

.loading-details {
    margin: 0;
    padding: 0;
    font-size: 26px;
    letter-spacing: 4px;
    color: var(--rally-text);
    -unity-font-style: bold;
}

.loading-footer {
    position: absolute;
    left: 110px;
    right: 110px;
    bottom: 90px;
}

.loading-tip-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 22px;
    max-width: 1300px;
}

.loading-tip {
    margin: 0 0 0 16px;
    padding: 0;
    font-size: 22px;
    white-space: normal;
    color: var(--rally-text);
}

.loading-bar {
    height: 8px;
    max-width: 1300px;
    background-color: rgba(255, 255, 255, 0.12);
}

.loading-fill {
    height: 100%;
    width: 0;
    background-color: var(--rally-yellow);
}
