<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Common.uss" />
    <Style src="RaceHud.uss" />
    <Style src="../Settings.uss" />
    <ui:VisualElement name="race-hud" class="race-hud" picking-mode="Ignore">
        <ui:VisualElement class="hud-panel hud-panel--top-left" picking-mode="Ignore">
            <ui:VisualElement class="stat" picking-mode="Ignore">
                <ui:Label text="POS" class="caption" picking-mode="Ignore" />
                <ui:Label name="position" text="1/1" class="stat-value" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="stat stat--last" picking-mode="Ignore">
                <ui:Label text="LAP" class="caption" picking-mode="Ignore" />
                <ui:Label name="lap" text="1/3" class="stat-value" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="hud-panel hud-panel--top-right" picking-mode="Ignore">
            <ui:Label text="TIME" class="caption" picking-mode="Ignore" />
            <ui:Label name="timer" text="0:00.000" class="timer" picking-mode="Ignore" />
            <ui:Label name="lap-time" text="LAP  0:00.000" class="minor" picking-mode="Ignore" />
            <ui:Label name="best-lap" text="BEST  -:--.---" class="minor" picking-mode="Ignore" />
            <ui:Label name="lap-delta" class="lap-delta" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-panel hud-panel--bottom-left" picking-mode="Ignore">
            <ui:VisualElement name="minimap" class="minimap" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-panel hud-panel--bottom-right" picking-mode="Ignore">
            <ui:VisualElement name="rev-bar" class="rev-bar" picking-mode="Ignore" />
            <ui:VisualElement class="speed-row" picking-mode="Ignore">
                <ui:VisualElement class="gear-box" picking-mode="Ignore">
                    <ui:Label text="GEAR" class="caption" picking-mode="Ignore" />
                    <ui:Label name="gear" text="N" class="gear" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="speed-box" picking-mode="Ignore">
                    <ui:Label name="speed" text="0" class="speed" picking-mode="Ignore" />
                    <ui:Label text="KM/H" class="caption" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="start-lights" class="start-lights start-lights--hidden" picking-mode="Ignore">
            <ui:VisualElement class="start-light" picking-mode="Ignore" />
            <ui:VisualElement class="start-light" picking-mode="Ignore" />
            <ui:VisualElement class="start-light" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="message" class="centre-message" picking-mode="Ignore" />
        <ui:Label name="wrong-way" text="WRONG WAY" class="wrong-way" picking-mode="Ignore" />
        <ui:Label name="countdown" class="countdown" picking-mode="Ignore" />
        <ui:VisualElement name="results" class="results">
            <ui:VisualElement class="results-card">
                <ui:Label text="RACE COMPLETE" class="results-title" />
                <ui:Label name="results-place" text="1st" class="results-place" />
                <ui:Label name="results-summary" class="results-summary" />
                <ui:VisualElement name="results-rewards" class="results-rewards">
                    <ui:VisualElement class="reward">
                        <ui:Label text="CREDITS EARNED" class="reward-caption" />
                        <ui:Label name="results-credits" class="reward-value reward-value--earned" />
                    </ui:VisualElement>
                    <ui:VisualElement class="reward">
                        <ui:Label text="TOTAL CREDITS" class="reward-caption" />
                        <ui:Label name="results-balance" class="reward-value" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="results-news" class="results-news" />
                <ui:VisualElement name="results-table" class="results-table" />
                <ui:Label name="results-laps" class="results-laps" />
                <ui:Button name="restart-button" text="RESTART RACE" class="restart-button" />
                <ui:Button name="menu-button" text="MAIN MENU" class="restart-button menu-button" />
                <ui:VisualElement name="results-hints" class="hint-keys card-hints" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause" class="pause">
            <ui:VisualElement class="pause-card">
                <ui:Label text="PAUSED" class="results-title" />
                <ui:Label name="pause-track" class="pause-track" />
                <ui:Label name="pause-summary" class="pause-summary" />
                <ui:Button name="pause-resume" text="RESUME" class="pause-button" />
                <ui:Button name="pause-restart" text="RESTART RACE" class="pause-button" />
                <ui:Button name="pause-settings" text="SETTINGS" class="pause-button" />
                <ui:Button name="pause-menu" text="MAIN MENU" class="pause-button" />
                <ui:VisualElement name="pause-hints" class="hint-keys card-hints" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settings" class="settings">
            <ui:VisualElement class="settings-card">
                <ui:Label text="SETTINGS" class="settings-title" />
                <ui:VisualElement name="settings-rows" class="settings-rows" />
                <ui:Button name="settings-back" text="BACK" class="settings-back" />
                <ui:VisualElement name="settings-hints" class="hint-keys card-hints settings-hints" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
